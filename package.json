{
  "name": "marginalia-md-reviewer",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:setup": "playwright install chromium",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test --project=e2e",
    "test:perf": "playwright test --project=perf",
    "test": "pnpm run test:unit && pnpm run build && pnpm run test:e2e && pnpm run test:perf",
    "deploy": "pnpm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "dompurify": "3.4.13",
    "markdown-it": "14.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
